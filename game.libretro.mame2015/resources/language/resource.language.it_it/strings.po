msgctxt "Addon Description"
msgid "Late 2014/Early 2015 version of MAME (0.160-ish) for libretro. Compatible with MAME 0.160 sets."
msgstr "Versione di fine 2014/inizio 2015 di MAME (circa 0.160) per libretro. Compatibile con i set MAME 0.160."

msgctxt "Addon Lifecyclestate"
msgid "MAME 2015 hasn't been updated since 2023 and is no longer available for use in Kodi."
msgstr "MAME 2015 non viene aggiornato dal 2023 e non è più disponibile per l'uso in Kodi."

